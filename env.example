# Configuration de la base de données
DATABASE_URL="mysql://user:password@localhost:3306/yomikai"

# Configuration NextAuth
# ⚠️ IMPORTANT EN PRODUCTION : 
# - NEXTAUTH_URL DOIT correspondre à votre domaine réel
# - En dev local: http://localhost:3000
# - En production: https://manga.yutoutcourt.ovh (sans trailing slash)
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Configuration de l'environnement
NODE_ENV="development"

# Configuration des uploads (optionnel)
UPLOAD_MAX_SIZE="10485760" # 10MB en bytes

# Configuration Docker (pour docker-compose)
DB_ROOT_PASSWORD="1234"
DB_NAME="yomikai"
DB_USER="yomikai"
DB_PASSWORD="1234" 